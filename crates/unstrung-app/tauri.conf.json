{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unstrung",
  "version": "0.1.0",
  "identifier": "io.github.codex-crusader.unstrung",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "pattern": { "use": "isolation", "options": { "dir": "../../isolation" } },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' avatar: http://avatar.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
