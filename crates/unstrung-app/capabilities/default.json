{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window gets only the app's own commands and event listening. No shell, file system, or network access.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-status",
    "allow-open-chat",
    "allow-send-message",
    "allow-retry-reply",
    "allow-stop-reply",
    "allow-restart-engine",
    "allow-self-test-mode",
    "allow-self-test-report"
  ]
}
